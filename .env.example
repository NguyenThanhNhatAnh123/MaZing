# Copy to .env (setup.bat does it) and fill in what you have.

# Claude reads the quote printed on each design (becomes the campaign title).
# Empty = no reading, titles are typed on the review cards.
ANTHROPIC_API_KEY=

# Models (optional): the first reads every design, the second re-reads unsure ones ("" = off)
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_HARD_MODEL=claude-opus-5-5

# Title casing: upper | as_printed
# TITLE_CASE=upper
# Short titles: use the beginning of the quote, at most 8 words and 60 characters.
# TITLE_MAX_WORDS=8
# TITLE_MAX_LENGTH=60

# Print canvas: canvas (4200 x 4800 px, default) | original (upload the file as it is)
# ARTWORK_MODE=canvas

# Optional path to installed Chrome, opened normally without automation.
# BROWSER_EXECUTABLE_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# DASHBOARD_PORT=8780

# Production origin allowed for per-device HTTPS sessions and extension pairing.
# MAYZING_PUBLIC_ORIGIN=https://mz.eagleglobal2023.com
# Persistent data location shared by application releases (never commit its contents).
# MAYZING_DATA_ROOT=F:/Mayzing
# Signing key is generated and kept in MAYZING_DATA_ROOT/.session-key by default.
# MAYZING_SESSION_SECRET=at-least-32-random-characters

# Configure the shared dashboard account with: python deploy/configure-login.py
# Credentials are hashed in MAYZING_DATA_ROOT/auth/web-login.json (never committed).
# Optional environment overrides require both fields; no plaintext password here.
# MAYZING_WEB_USER=
# MAYZING_WEB_PASSWORD_HASH=
# Require login on loopback too (default: login required for production HTTPS).
# MAYZING_REQUIRE_LOCAL_LOGIN=1
