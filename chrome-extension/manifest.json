{
  "manifest_version": 3,
  "name": "Mayzing Session Bridge",
  "version": "1.1.0",
  "description": "Nối một tab Mayzing do bạn chọn với tool upload trên máy. Không xuất cookie.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {"default_title": "Kết nối tab Mayzing", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js"}
}
